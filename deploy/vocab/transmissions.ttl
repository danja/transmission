# http://purl.org/stuff/transmissions/
#
# GENERATED by scripts/build-vocab-site.js from vocabs/. Do not edit: edit the
# file the term lives in and run `npm run build:vocab`.
#
# This is the whole trn: namespace as one document, because the namespace is
# one thing and the sources are 7. Sources, in order:
#   vocabs/ontology.ttl
#   vocabs/profile.ttl
#   vocabs/project.ttl
#   vocabs/parameters.ttl
#   vocabs/formats.ttl
#   vocabs/actions.ttl
#   vocabs/djset.ttl

# ----------------------------------------------------------------------------
# vocabs/ontology.ttl
# ----------------------------------------------------------------------------

@prefix trn:     <http://purl.org/stuff/transmissions/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

# The namespace's own description. Separate from the term files so that each of
# those stays a list of terms, and so the document served at the namespace IRI
# says what it is rather than only what is in it.
#
# scripts/build-vocab-site.js merges this with the term files into
# deploy/vocab/transmissions.ttl, which is what
# http://purl.org/stuff/transmissions/ resolves to.

<http://purl.org/stuff/transmissions/>
    a owl:Ontology ;
    rdfs:label "Transmission" ;
    dcterms:title "Transmission Vocabulary" ;
    dcterms:description """Terms for describing audio plugins and the graphs they run in:
        what a plugin is musically, the signals it accepts and produces, how nodes are
        routed, the actions an agent can ask a host to perform, and the shape of a DJ set
        list. It is used by Transmission, by the plugin-universe catalogue, by downspout's
        plugin profiles and by JigDAW, whose web delivery terms extend it rather than
        replacing it.""" ;
    vann:preferredNamespacePrefix "trn" ;
    vann:preferredNamespaceUri "http://purl.org/stuff/transmissions/" ;
    rdfs:seeAlso <https://danja.github.io/transmission/> ,
                 <https://github.com/danja/transmission> .

# ----------------------------------------------------------------------------
# vocabs/profile.ttl
# ----------------------------------------------------------------------------

@prefix trn:      <http://purl.org/stuff/transmissions/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .

## ── Classes ──────────────────────────────────────────────────────────────────

trn:PluginProfile    a owl:Class ; rdfs:label "Plugin Profile" ;
    rdfs:comment "Curated behavioural knowledge about a VST3 plugin." .

trn:DiscoveredPlugin a owl:Class ; rdfs:label "Discovered Plugin" ;
    rdfs:comment "Technical metadata extracted by the isolated VST3 inspector." .

## Role taxonomy
trn:PluginRole            a owl:Class ; rdfs:label "Plugin Role" .
trn:AudioEffect           a owl:Class ; rdfs:subClassOf trn:PluginRole ; rdfs:label "Audio Effect" .
trn:AudioMixer            a owl:Class ; rdfs:subClassOf trn:PluginRole ; rdfs:label "Audio Mixer" .
trn:AudioInstrument       a owl:Class ; rdfs:subClassOf trn:PluginRole ; rdfs:label "Audio Instrument" .
trn:AudioSource           a owl:Class ; rdfs:subClassOf trn:PluginRole ; rdfs:label "Audio Source" .
trn:AudioSink             a owl:Class ; rdfs:subClassOf trn:PluginRole ; rdfs:label "Audio Sink" .
trn:MidiGenerator         a owl:Class ; rdfs:subClassOf trn:PluginRole ; rdfs:label "MIDI Generator" .
trn:MidiProcessor         a owl:Class ; rdfs:subClassOf trn:PluginRole ; rdfs:label "MIDI Processor" .
trn:Instrument            a owl:Class ; rdfs:subClassOf trn:PluginRole ; rdfs:label "Instrument" .
trn:DrumInstrument        a owl:Class ; rdfs:subClassOf trn:Instrument  ; rdfs:label "Drum Instrument" .
trn:BassInstrument        a owl:Class ; rdfs:subClassOf trn:Instrument  ; rdfs:label "Bass Instrument" .
trn:Controller            a owl:Class ; rdfs:subClassOf trn:PluginRole  ; rdfs:label "Controller" ;
    rdfs:comment "Emits control signals (CC, scene notes) that reshape other plugins rather than producing musical audio or notes." .
trn:PerformanceInstrument a owl:Class ; rdfs:subClassOf trn:PluginRole  ; rdfs:label "Performance Instrument" .
trn:Utility               a owl:Class ; rdfs:subClassOf trn:PluginRole  ; rdfs:label "Utility" .

## Signal type instances
trn:Audio         a owl:NamedIndividual ; rdfs:label "Audio" .
trn:Midi          a owl:NamedIndividual ; rdfs:label "MIDI" .
trn:BassMidi      a owl:NamedIndividual ; rdfs:label "Bass MIDI" .
trn:DrumMidi      a owl:NamedIndividual ; rdfs:label "Drum MIDI" .
trn:MelodyMidi    a owl:NamedIndividual ; rdfs:label "Melody MIDI" .
trn:HarmonyMidi   a owl:NamedIndividual ; rdfs:label "Harmony MIDI" .
trn:MultiPartMidi a owl:NamedIndividual ; rdfs:label "Multi-part MIDI" .
trn:ControlMidi   a owl:NamedIndividual ; rdfs:label "Control MIDI" ;
    rdfs:comment "MIDI CCs and scene notes used to reshape other generators rather than to produce musical content directly." .

## Host requirement instances
trn:HostTransport a owl:NamedIndividual ; rdfs:label "Host Transport" ;
    rdfs:comment "Plugin requires the host to provide tempo/beat position." .
trn:Launchpad     a owl:NamedIndividual ; rdfs:label "Launchpad" ;
    rdfs:comment "Plugin expects a Novation Launchpad MIDI controller for full functionality." .

## ── Profile properties ───────────────────────────────────────────────────────

trn:role              a owl:ObjectProperty ; rdfs:domain trn:PluginProfile ; rdfs:range trn:PluginRole .
trn:produces          a owl:ObjectProperty ; rdfs:domain trn:PluginProfile .
trn:accepts           a owl:ObjectProperty ; rdfs:domain trn:PluginProfile .
trn:requires          a owl:ObjectProperty ; rdfs:domain trn:PluginProfile .
trn:recommendedBefore a owl:ObjectProperty ; rdfs:domain trn:PluginProfile .
trn:recommendedAfter  a owl:ObjectProperty ; rdfs:domain trn:PluginProfile .
trn:companion         a owl:ObjectProperty ; rdfs:domain trn:PluginProfile .
trn:genre             a owl:DatatypeProperty ; rdfs:domain trn:PluginProfile ; rdfs:range xsd:string .
trn:caution           a owl:DatatypeProperty ; rdfs:domain trn:PluginProfile ; rdfs:range xsd:string .
trn:homepage          a owl:DatatypeProperty ; rdfs:domain trn:PluginProfile ; rdfs:range xsd:anyURI .

## ── Conductor / CC-control routing ──────────────────────────────────────────
##
## These properties let agents understand which plugins feed CC control signals
## into which receivers and what parameter to set to enable the link.

trn:feedsControls a owl:ObjectProperty ; rdfs:domain trn:PluginProfile ;
    rdfs:label "feeds controls" ;
    rdfs:comment "This plugin emits MIDI CC or scene control signals that can reshape live parameters on the target plugin. Route its MIDI output to the target's MIDI input and set the target's conductor channel parameter to match." .

trn:conductorChannelParam a owl:DatatypeProperty ; rdfs:domain trn:PluginProfile ; rdfs:range xsd:string ;
    rdfs:label "conductor channel parameter" ;
    rdfs:comment "Name of the parameter on this (receiver) plugin that selects which MIDI channel to listen on for Conductor CCs. Set to 0 to disable." .

## ── CC mapping vocabulary ────────────────────────────────────────────────────
##
## Use trn:ccMapping to attach one or more mapping blank nodes to a profile.
## Each blank node carries trn:ccNumber, trn:ccRole, and trn:targetParameter.

trn:ccMapping      a owl:ObjectProperty ; rdfs:domain trn:PluginProfile ;
    rdfs:label "CC mapping" ;
    rdfs:comment "Links a plugin profile to a blank node describing one CC→parameter binding." .

trn:ccNumber       a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "CC number" ;
    rdfs:comment "MIDI continuous controller number (0–127)." .

trn:ccRole         a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "CC role" ;
    rdfs:comment "Semantic name for this CC as emitted by the controller (e.g. Density, Energy, Scene, Reset)." .

trn:targetParameter a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "target parameter" ;
    rdfs:comment "Symbol or display name of the plugin parameter driven by this CC." .

trn:ccTriggerValue a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "CC trigger value" ;
    rdfs:comment "When set, the mapping fires only when the CC value equals this integer (e.g. 127 for Reset triggers)." .

## ── Discovery properties ─────────────────────────────────────────────────────

trn:bundleName      a owl:DatatypeProperty ; rdfs:range xsd:string .
trn:vstClassId      a owl:DatatypeProperty ; rdfs:range xsd:string .
trn:vendor          a owl:DatatypeProperty ; rdfs:range xsd:string .
trn:category        a owl:DatatypeProperty ; rdfs:range xsd:string .
trn:modulePath      a owl:DatatypeProperty ; rdfs:range xsd:string .
trn:discoverySource a owl:DatatypeProperty ; rdfs:range xsd:string .

trn:parameter         a owl:ObjectProperty .
trn:parameterTitle    a owl:DatatypeProperty ; rdfs:range xsd:string .
trn:shortTitle        a owl:DatatypeProperty ; rdfs:range xsd:string .
trn:units             a owl:DatatypeProperty ; rdfs:range xsd:string .
trn:defaultNormalized a owl:DatatypeProperty ; rdfs:range xsd:decimal .
trn:stepCount         a owl:DatatypeProperty ; rdfs:range xsd:integer .
trn:parameterFlags    a owl:DatatypeProperty ; rdfs:range xsd:integer .

## ── Collections ──────────────────────────────────────────────────────────────
##
## A named set of plugins, published as one document at one URL: something to
## hand a host that means "these", whether that is a curated set of reverbs,
## the plugins from one vendor, or the ones a tutorial uses. Membership is
## dcterms:hasPart and each member's name is rdfs:label, both reused
## unchanged, so the only term minted here is the class a reader looks for.
##
## Proposed upstream from JigDAW (see jigdaw/docs/plugin-collections.md,
## normative there), because nothing about the shape is specific to a web
## plugin: a native VST3 catalogue or plugin-universe could publish one the
## same way. jig:PluginCollection there is now a subclass of this, kept
## rather than replaced so a collection already published under that class
## does not stop validating against it.

trn:PluginCollection a owl:Class ;
    rdfs:subClassOf dcmitype:Collection ;
    rdfs:label "Plugin Collection" ;
    rdfs:comment """A named set of plugins, each included by its IRI with dcterms:hasPart
        and named with rdfs:label in the collection document. A collection is one
        publisher's opinion about what is worth finding: it confers no trust, carries no
        code and no digests, and the profile or discovery record at each IRI governs
        wherever the two disagree.""" .

# ----------------------------------------------------------------------------
# vocabs/project.ttl
# ----------------------------------------------------------------------------

@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

## The project format: the graph, the transport and the arrangement, as saved.
##
## Every term here was already in use, written and read by
## src/rdf/TransmissionRdf.js and named in src/rdf/Vocabulary.js, and declared
## nowhere. They are recorded now because http://purl.org/stuff/transmissions/
## resolves, so a term in a saved project is a promise that something is served
## at the other end of it. tests/vocab/site.test.js binds this file to
## src/rdf/Vocabulary.js in both directions.

## ── The project ─────────────────────────────────────────────────────────────

trn:Transmission a owl:Class ; rdfs:label "Transmission" ;
    rdfs:comment "One saved project: a graph of nodes, the connections between them, and the transport and arrangement state that go with it." .

trn:EntryTransmission a owl:Class ; rdfs:subClassOf trn:Transmission ;
    rdfs:label "Entry Transmission" ;
    rdfs:comment "The transmission a file is opened at, where a file holds more than one." .

trn:pipe a owl:ObjectProperty ; rdfs:domain trn:Transmission ;
    rdfs:label "pipe" ;
    rdfs:comment "The project's nodes, as an rdf:List. The order is the order they were added and is not the execution order, which the scheduler computes from the connections." .

trn:connections a owl:ObjectProperty ; rdfs:domain trn:Transmission ;
    rdfs:label "connections" ;
    rdfs:comment "The edges between nodes, as an rdf:List. Absent means a chain: each node connected to the next, which is what a project written before connections existed means." .

trn:systemInputConnections a owl:DatatypeProperty ; rdfs:domain trn:Transmission ; rdfs:range xsd:string ;
    rdfs:label "system input connections" ;
    rdfs:comment "The JACK or PipeWire ports the system input is wired to, by name, one per channel. \"No connection\" for a channel that is not wired." .

trn:systemOutputConnections a owl:DatatypeProperty ; rdfs:domain trn:Transmission ; rdfs:range xsd:string ;
    rdfs:label "system output connections" ;
    rdfs:comment "The same for the system output. Port names rather than indices, so a session reopens onto the same hardware after the device order has changed." .

## ── Nodes ───────────────────────────────────────────────────────────────────

trn:VST3Plugin a owl:Class ; rdfs:label "VST3 Plugin" ;
    rdfs:comment "A node that is a VST3 loaded from disk, named by trn:pluginPath or by a plugin profile IRI." .

trn:JigdawPlugin a owl:Class ; rdfs:label "JigDAW Plugin" ;
    rdfs:comment "A node that is a JigDAW plugin: a WebAssembly module named by a dereferenceable IRI in trn:pluginIri. Fetching that IRI returns the profile, and there is no other install step." .

trn:AudioInput a owl:Class ; rdfs:label "Audio Input" ;
    rdfs:comment "The built-in node carrying audio from the system input into the graph." .

trn:AudioOutput a owl:Class ; rdfs:label "Audio Output" ;
    rdfs:comment "The built-in node carrying audio from the graph to the system output." .

trn:MidiInput a owl:Class ; rdfs:label "MIDI Input" ;
    rdfs:comment "The built-in node carrying MIDI from an external device into the graph." .

trn:MidiOutput a owl:Class ; rdfs:label "MIDI Output" ;
    rdfs:comment "The built-in node carrying MIDI from the graph to an external device." .

trn:Gain a owl:Class ; rdfs:label "Gain" ;
    rdfs:comment "A built-in gain node. A host service rather than a plugin, so it is a node type rather than something loaded." .

trn:AudioClipNode a owl:Class ; rdfs:label "Audio Clip Node" ;
    rdfs:comment "A node that plays an audio clip from the arrangement rather than processing its input." .

trn:MidiClipNode a owl:Class ; rdfs:label "MIDI Clip Node" ;
    rdfs:comment "A node that plays a MIDI clip from the arrangement." .

trn:pluginPath a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "plugin path" ;
    rdfs:comment "Where a VST3 bundle is on this machine. A property of an installation, not of the plugin, which is why a profile IRI is preferred where there is one." .

trn:pluginIri a owl:DatatypeProperty ; rdfs:domain trn:JigdawPlugin ; rdfs:range xsd:string ;
    rdfs:label "plugin IRI" ;
    rdfs:comment "The dereferenceable IRI of a JigDAW plugin. Unlike trn:pluginPath this identifies the plugin rather than a copy of it, so a project carrying one opens on another machine." .

trn:jigdawAssetOverrides a owl:ObjectProperty ; rdfs:domain trn:JigdawPlugin ;
    rdfs:label "JigDAW asset overrides" ;
    rdfs:comment "Local files loaded into a JigDAW node's jig:userReplaceable assets, as an rdf:List of nodes carrying trn:assetKey and trn:assetPath. Like trn:pluginPath these name files on this machine, so a project carrying them opens with the shipped defaults elsewhere." .

trn:assetKey a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "asset key" ;
    rdfs:comment "Which user-replaceable asset of a JigDAW plugin an override is for, by the asset's fragment (e.g. \"nam\")." .

trn:assetPath a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "asset path" ;
    rdfs:comment "The local file loaded into a JigDAW asset in place of the shipped default." .

trn:audioInputs a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "audio inputs" ;
    rdfs:comment "How many audio input ports the node has. Read back from the plugin when the project is applied; the declaration is what the file says, not what decides." .

trn:audioOutputs a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "audio outputs" .
trn:midiInputs  a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "MIDI inputs" .
trn:midiOutputs a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "MIDI outputs" .

trn:settings a owl:ObjectProperty ;
    rdfs:label "settings" ;
    rdfs:comment "Node settings that are not plugin parameters: what the node is pointed at, rather than how it is tuned." .

trn:parameters a owl:ObjectProperty ;
    rdfs:label "parameters" ;
    rdfs:comment "The node's saved parameter values, as an rdf:List of nodes carrying trn:parameterId and trn:normalizedValue." .

trn:componentState a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "component state" ;
    rdfs:comment "A VST3 component's opaque saved state, base64 encoded. Not interpretable outside the plugin that wrote it." .

trn:controllerState a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "controller state" ;
    rdfs:comment "The matching controller state, saved and restored alongside the component state." .

## Editor metadata. A separate concern from execution: moving a node on screen
## must not change what the graph computes.
trn:editorX a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "editor x" .
trn:editorY a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "editor y" .

## ── Connections ─────────────────────────────────────────────────────────────

trn:from a owl:ObjectProperty ; rdfs:label "from" ;
    rdfs:comment "The node an edge leaves." .

trn:to a owl:ObjectProperty ; rdfs:label "to" ;
    rdfs:comment "The node an edge enters." .

trn:kind a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "kind" ;
    rdfs:comment "What travels along the edge: \"audio\" or \"midi\". Two nodes may be joined by one of each, so the kind is part of what identifies an edge rather than a note about it." .

trn:fromPort a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "from port" ;
    rdfs:comment "Which output port of the source node, zero based." .

trn:toPort a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "to port" ;
    rdfs:comment "Which input port of the target node, zero based." .

## ── Transport ───────────────────────────────────────────────────────────────

trn:tempoMap a owl:ObjectProperty ; rdfs:domain trn:Transmission ;
    rdfs:label "tempo map" ;
    rdfs:comment "Tempo changes as an rdf:List, each carrying trn:atBeat and trn:bpm. A map rather than one tempo, so a project can change speed without the timeline meaning something different before and after." .

trn:bpm a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "bpm" ;
    rdfs:comment "Beats per minute, from the beat this entry is at until the next one." .

trn:loopStart a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "loop start" ;
    rdfs:comment "The beat the loop starts at. A loop needs both ends; one alone is ignored." .
trn:loopEnd a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "loop end" .

## ── Arrangement ─────────────────────────────────────────────────────────────

trn:arrangementLength a owl:DatatypeProperty ; rdfs:domain trn:Transmission ; rdfs:range xsd:decimal ;
    rdfs:label "arrangement length" ;
    rdfs:comment "How long the arrangement is, in beats." .

trn:midiClips a owl:ObjectProperty ; rdfs:domain trn:Transmission ;
    rdfs:label "MIDI clips" ;
    rdfs:comment "The arrangement's MIDI clips, as an rdf:List." .

trn:clipId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "clip id" ;
    rdfs:comment "A clip's identifier within the arrangement." .

trn:startBeat a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "start beat" ;
    rdfs:comment "Where a clip or a note begins, in beats. A note's is relative to its clip." .

trn:lengthBeats a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "length in beats" .

trn:notes a owl:ObjectProperty ;
    rdfs:label "notes" ;
    rdfs:comment "A clip's notes, as an rdf:List." .

trn:pitch a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "pitch" ;
    rdfs:comment "MIDI note number, 0 to 127." .

trn:velocity a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "velocity" ;
    rdfs:comment "MIDI velocity, 0 to 127." .

trn:channel a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "channel" ;
    rdfs:comment "MIDI channel, for a note or for a controller mapping." .

trn:gainLanes a owl:ObjectProperty ; rdfs:domain trn:Transmission ;
    rdfs:label "gain lanes" ;
    rdfs:comment "Gain automation, one lane per target node, as an rdf:List." .

trn:points a owl:ObjectProperty ;
    rdfs:label "points" ;
    rdfs:comment "A lane's breakpoints, as an rdf:List, each with trn:atBeat, trn:valueDb and trn:shape." .

trn:valueDb a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "value in dB" ;
    rdfs:comment "The gain at this breakpoint, in decibels." .

trn:shape a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "shape" ;
    rdfs:comment "How the value moves to the next breakpoint. \"linear\" when unstated." .

## ── MIDI control mapping ────────────────────────────────────────────────────

trn:midiMappings a owl:ObjectProperty ; rdfs:domain trn:Transmission ;
    rdfs:label "MIDI mappings" ;
    rdfs:comment "External controller assignments, as an rdf:List. Each names a target node, a parameter and the channel and controller number that drive it." .

trn:controller a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "controller" ;
    rdfs:comment "The MIDI continuous controller number a mapping listens to." .

trn:consume a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:label "consume" ;
    rdfs:comment "Whether the mapped message stops here rather than also reaching the plugin. True unless stated otherwise." .

## ── Audio settings ──────────────────────────────────────────────────────────

trn:audioSettings a owl:ObjectProperty ; rdfs:domain trn:Transmission ;
    rdfs:label "audio settings" ;
    rdfs:comment "Engine settings saved with the project. Properties of this machine rather than of the music, kept so a session reopens as it was running." .

trn:renderAheadMs a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "render ahead (ms)" .

trn:requestedBufferSize a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "requested buffer size" ;
    rdfs:comment "Frames per block to ask the device for. 0 means whatever the device offers." .

trn:processingThreads a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "processing threads" ;
    rdfs:comment "How many threads run independent nodes in parallel. 0 means decide from the machine." .

# ----------------------------------------------------------------------------
# vocabs/parameters.ttl
# ----------------------------------------------------------------------------

@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

## The parameter terms downspout's hand-written profiles use.
##
## All of these were already in published profiles and declared nowhere. They
## are recorded because http://purl.org/stuff/transmissions/ now resolves, and a
## term in a published profile is a promise that something is served at the
## other end of it. Counts below are from the 52 profiles in
## ~/github/downspout/plugins as of 2026-09-18.
##
## Several are marked deprecated rather than described as good practice. That is
## not a judgement made here: plugin-universe's catalogue already normalises
## them away, and the replacement in every case is an lv2: term that says the
## same thing in a form a query can compare.

## ── Describing one parameter ────────────────────────────────────────────────

trn:symbol a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "symbol" ;
    rdfs:comment "A parameter's stable machine name, as in \"duck_depth\". What automation and a saved project key on, as against the human label, which may be translated or changed. Equivalent to lv2:symbol." .

trn:unit a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "unit" ;
    rdfs:comment "The unit a parameter is expressed in, as a display string such as \"%\", \"ms\" or \"Hz\". units:unit carries the same thing as an IRI, which is comparable where this is not." .

trn:default a owl:DatatypeProperty ;
    rdfs:label "default" ;
    rdfs:comment "The value a parameter takes when the plugin loads, in the parameter's own units rather than normalised." .

trn:datatype a owl:ObjectProperty ;
    rdfs:label "datatype" ;
    rdfs:comment "What kind of number a parameter is: xsd:float, xsd:integer or xsd:boolean. A boolean parameter is a switch and an integer one steps, and a generated control that does not know this draws a continuous slider for both." .

trn:paramId a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "parameter id" ;
    rdfs:comment "The host-facing identifier a parameter is addressed by, which is a property of the build rather than a position in the document." .

trn:direction a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "direction" ;
    rdfs:comment "\"input\" or \"output\". An output parameter is read by the host and not set by it, such as a meter." .

trn:readonly a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:label "read only" ;
    rdfs:comment "True where the host may read a parameter and must not write it." .

trn:range a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "range" ;
    rdfs:comment "A parameter's range written for a person, as in \"0-100\" or \"0.10-1.50 m\". It is a display string and nothing can compare two of them, so lv2:minimum and lv2:maximum are what a host should be given. Kept because 28 published profiles carry one." .

## ── Plugin-level state and bus behaviour ────────────────────────────────────

trn:state a owl:DatatypeProperty ;
    rdfs:label "state" ;
    rdfs:comment "Plugin state that is not a parameter, saved and restored with the project." .

trn:stateKey a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "state key" ;
    rdfs:comment "The key a piece of such state is stored under." .

trn:ccGate a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:label "CC gate" ;
    rdfs:comment "True where the plugin is gated by a MIDI continuous controller rather than by note on and note off." .

trn:busRole a owl:ObjectProperty ; rdfs:range trn:BusRole ;
    rdfs:label "bus role" ;
    rdfs:comment "Which end of a shared bus a plugin sits at. The bus carries signal between plugins that are not connected in the graph, so the role is the only statement of the relationship." .

trn:BusRole a owl:Class ; rdfs:label "Bus Role" .

trn:BusProducer a trn:BusRole ; rdfs:label "Bus Producer" ;
    rdfs:comment "Writes to a shared bus." .

trn:BusReceiver a trn:BusRole ; rdfs:label "Bus Receiver" ;
    rdfs:comment "Reads from a shared bus." .

trn:InstrumentPlugin a owl:Class ; rdfs:subClassOf trn:PluginRole ;
    rdfs:label "Instrument Plugin" ;
    rdfs:comment "Used by one published profile where trn:AudioInstrument is meant. Kept so the IRI resolves." .

trn:Sampler a owl:Class ; rdfs:subClassOf trn:PluginRole ;
    rdfs:label "Sampler" ;
    rdfs:comment "An instrument that plays recorded audio rather than synthesising it." .

## ── Retired ─────────────────────────────────────────────────────────────────
## rdfs: already says both of these, and a profile that uses the trn: spelling
## is invisible to every tool that looks for the standard one.

trn:label   owl:deprecated true ; rdfs:comment "Use rdfs:label." .
trn:comment owl:deprecated true ; rdfs:comment "Use rdfs:comment." .

# ----------------------------------------------------------------------------
# vocabs/formats.ttl
# ----------------------------------------------------------------------------

@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

## Plugin formats, and the terms retired in favour of lv2:.
##
## Moved here from plugin-universe's vocabs/trn-extensions.ttl, which says in
## its own header that these should be proposed upstream to this repository
## rather than maintained separately. This is upstream. The wording is that
## file's, unchanged.
##
## plugin-universe keeps its copy because its SHACL shapes validate against it
## there. tests/vocab/site.test.js compares the two when that checkout is
## present, so the pair cannot drift silently; it skips when it is absent, so
## nothing here depends on it.

## ── Plugin formats ──────────────────────────────────────────────────────────
## valis improvises this as val:formats "VST3" string literals. Typed
## individuals let a query ask for LV2 plugins without matching on strings.

trn:PluginFormat a owl:Class ; rdfs:label "Plugin Format" .

trn:VST3       a trn:PluginFormat ; rdfs:label "VST3" .
trn:VST2       a trn:PluginFormat ; rdfs:label "VST2" .
trn:CLAP       a trn:PluginFormat ; rdfs:label "CLAP" .
trn:AudioUnit  a trn:PluginFormat ; rdfs:label "Audio Unit" .
trn:AudioUnitV3 a trn:PluginFormat ; rdfs:label "Audio Unit v3" .
trn:LV2        a trn:PluginFormat ; rdfs:label "LV2" .
trn:LADSPA     a trn:PluginFormat ; rdfs:label "LADSPA" .
trn:AAX        a trn:PluginFormat ; rdfs:label "AAX" .
trn:Standalone a trn:PluginFormat ; rdfs:label "Standalone" .

## A plugin that runs in a browser. Not a native binary and not a wrapper around
## one: the processor is JavaScript on an AudioWorklet and the signal processing
## is WebAssembly, fetched from the plugin's own IRI. Added for JigDAW, whose
## plugins are all of this kind and none of the others, and which could not
## publish a conformant profile without it.
##
## pu:supportedPlatform does not apply to one of these. The platform is the
## browser, which is not one of the operating systems that predicate enumerates,
## and this format term carries what the platform list was carrying.
trn:WebAudio   a trn:PluginFormat ; rdfs:label "Web Audio" .

## A JigDAW plugin: a profile typed jig:WebPlugin that a host fetches from the
## plugin's own IRI, verified by digest before anything runs. A specific format
## rather than the generic technology it is built on, so a catalogue can say
## "Jig" the way it says "VST3" — which is what the plugin's own profile
## declares with trn:format trn:Jig.
trn:Jig        a trn:PluginFormat ; rdfs:label "Jig" .

trn:format a owl:ObjectProperty ; rdfs:range trn:PluginFormat ;
    rdfs:label "format" ;
    rdfs:comment "A plugin format this plugin is built for." .

## ── Deprecations ────────────────────────────────────────────────────────────
## Terms in use across downspout that the catalogue normalises away. Recorded
## here so the normaliser has something to point at, and so nobody reintroduces
## them by copying an existing profile.

trn:min     owl:deprecated true ; rdfs:comment "Use lv2:minimum. Downspout uses trn:min and trn:minimum inconsistently; both are retired." .
trn:max     owl:deprecated true ; rdfs:comment "Use lv2:maximum." .
trn:minimum owl:deprecated true ; rdfs:comment "Use lv2:minimum." .
trn:maximum owl:deprecated true ; rdfs:comment "Use lv2:maximum." .
trn:hasParameter owl:deprecated true ; rdfs:comment "Typo for trn:parameter; parameters now use lv2:port." .
trn:MIDI    owl:deprecated true ; rdfs:comment "Typo for trn:Midi." .

# ----------------------------------------------------------------------------
# vocabs/actions.ttl
# ----------------------------------------------------------------------------

@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

## ── Action class hierarchy ───────────────────────────────────────────────────

trn:Action          a owl:Class ; rdfs:label "Action" .
trn:GraphAction     a owl:Class ; rdfs:subClassOf trn:Action ; rdfs:label "Graph Action" .
trn:TransportAction a owl:Class ; rdfs:subClassOf trn:Action ; rdfs:label "Transport Action" .
trn:ProjectAction   a owl:Class ; rdfs:subClassOf trn:Action ; rdfs:label "Project Action" .
trn:PluginAction    a owl:Class ; rdfs:subClassOf trn:Action ; rdfs:label "Plugin Action" .

## Graph operations
trn:ChangeSet          a owl:Class ; rdfs:subClassOf trn:GraphAction ;
    rdfs:label "Change Set" ;
    rdfs:comment "Atomic list of graph operations applied against an expected revision." .
trn:AddNode            a owl:Class ; rdfs:subClassOf trn:GraphAction .
trn:UpdateNode         a owl:Class ; rdfs:subClassOf trn:GraphAction .
trn:RemoveNode         a owl:Class ; rdfs:subClassOf trn:GraphAction .
trn:AddConnection      a owl:Class ; rdfs:subClassOf trn:GraphAction .
trn:RemoveConnection   a owl:Class ; rdfs:subClassOf trn:GraphAction .
trn:SetProjectMetadata a owl:Class ; rdfs:subClassOf trn:GraphAction .

## Transport operations
trn:PlayAction         a owl:Class ; rdfs:subClassOf trn:TransportAction .
trn:StopAction         a owl:Class ; rdfs:subClassOf trn:TransportAction .
trn:ConfigureTransport a owl:Class ; rdfs:subClassOf trn:TransportAction .

## Parameter operation
trn:SetParameter a owl:Class ; rdfs:subClassOf trn:Action .

## Project operations
trn:OpenProject a owl:Class ; rdfs:subClassOf trn:ProjectAction .
trn:SaveProject a owl:Class ; rdfs:subClassOf trn:ProjectAction .
trn:NewProject  a owl:Class ; rdfs:subClassOf trn:ProjectAction .

## Plugin operations
trn:ScanPlugins a owl:Class ; rdfs:subClassOf trn:PluginAction .

## ── Common action properties ─────────────────────────────────────────────────

trn:operations       a owl:ObjectProperty ;
    rdfs:comment "rdf:List of operation blank nodes within a ChangeSet." .
trn:expectedRevision a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Project revision the client last observed; rejected if stale." .
trn:dryRun           a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:comment "Validate without committing when true." .
trn:filePath         a owl:DatatypeProperty ; rdfs:range xsd:string .
trn:nodeId           a owl:DatatypeProperty ; rdfs:range xsd:string .
trn:parameterId      a owl:DatatypeProperty ; rdfs:range xsd:integer .
trn:normalizedValue  a owl:DatatypeProperty ; rdfs:range xsd:decimal .
trn:sampleOffset     a owl:DatatypeProperty ; rdfs:range xsd:integer .

## Transport configure properties
trn:tempo            a owl:DatatypeProperty ; rdfs:range xsd:decimal .
trn:atBeat           a owl:DatatypeProperty ; rdfs:range xsd:decimal .
trn:positionBeats    a owl:DatatypeProperty ; rdfs:range xsd:decimal .
trn:clearLoop        a owl:DatatypeProperty ; rdfs:range xsd:boolean .
trn:loopStartBeat    a owl:DatatypeProperty ; rdfs:range xsd:decimal .
trn:loopEndBeat      a owl:DatatypeProperty ; rdfs:range xsd:decimal .
trn:loopEnabled      a owl:DatatypeProperty ; rdfs:range xsd:boolean .

## Operation payload encoding (JSON literals for complex nested structures)
trn:nodeJson         a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "JSON-encoded node definition within an AddNode or UpdateNode operation." .
trn:connectionJson   a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "JSON-encoded connection definition within an AddConnection or RemoveConnection operation." .
trn:changesJson      a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "JSON-encoded partial node changes within an UpdateNode operation." .
trn:metadataJson     a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "JSON-encoded metadata object within a SetProjectMetadata operation." .

## ── Server configuration ─────────────────────────────────────────────────────

trn:ServerConfig   a owl:Class ; rdfs:label "Server Configuration" .
trn:port           a owl:DatatypeProperty ; rdfs:domain trn:ServerConfig ; rdfs:range xsd:integer .
trn:bindAddress    a owl:DatatypeProperty ; rdfs:domain trn:ServerConfig ; rdfs:range xsd:string .
trn:allowedRoots   a owl:ObjectProperty   ; rdfs:domain trn:ServerConfig .

# ----------------------------------------------------------------------------
# vocabs/djset.ttl
# ----------------------------------------------------------------------------

@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

## DJ Set vocabulary for Transmission.
##
## A trn:DJSet is an ordered sequence of trn:Cue items. A runner executes the
## set list by opening each patch, configuring transport, playing for the stated
## duration, then advancing to the next cue. Parameter changes scheduled within
## a cue are applied at the given beat offset from cue start.
##
## Reuses from actions.ttl: trn:filePath, trn:tempo, trn:atBeat,
##   trn:parameterId, trn:normalizedValue.
## Reuses from profile.ttl: trn:genre.

## ── Classes ───────────────────────────────────────────────────────────────────

trn:DJSet a owl:Class ;
    rdfs:label "DJ Set" ;
    rdfs:comment "A complete DJ performance comprising an ordered sequence of cues." .

trn:Cue a owl:Class ;
    rdfs:label "Cue" ;
    rdfs:comment "One slot in a DJ set: a patch to load and play for a given duration." .

trn:Transition a owl:Class ;
    rdfs:label "Transition" ;
    rdfs:comment "How playback moves from the end of one cue to the start of the next." .

trn:HardCut a owl:Class ; rdfs:subClassOf trn:Transition ;
    rdfs:label "Hard Cut" ;
    rdfs:comment "Stop the outgoing cue on the next bar boundary, then load and start the next." .

trn:Crossfade a owl:Class ; rdfs:subClassOf trn:Transition ;
    rdfs:label "Crossfade" ;
    rdfs:comment "Fade out the outgoing cue while the incoming one fades in. Requires a mixer node that responds to gain parameters." .

trn:ParameterChange a owl:Class ;
    rdfs:label "Parameter Change" ;
    rdfs:comment "A timed parameter automation step applied at a beat offset within a cue." .

## ── DJSet properties ─────────────────────────────────────────────────────────

trn:cues a owl:ObjectProperty ;
    rdfs:domain trn:DJSet ;
    rdfs:label "cues" ;
    rdfs:comment "Ordered rdf:List of trn:Cue items in this set." .

trn:setDate a owl:DatatypeProperty ;
    rdfs:domain trn:DJSet ;
    rdfs:range xsd:date ;
    rdfs:label "set date" .

trn:artist a owl:DatatypeProperty ;
    rdfs:domain trn:DJSet ;
    rdfs:range xsd:string ;
    rdfs:label "artist" .

trn:venue a owl:DatatypeProperty ;
    rdfs:domain trn:DJSet ;
    rdfs:range xsd:string ;
    rdfs:label "venue" .

## ── Cue properties ────────────────────────────────────────────────────────────

## trn:filePath (from actions.ttl) — absolute path to the Turtle project file.

trn:durationBeats a owl:DatatypeProperty ;
    rdfs:domain trn:Cue ;
    rdfs:range xsd:integer ;
    rdfs:label "duration beats" ;
    rdfs:comment "Number of beats to play before advancing to the next cue. 0 means play indefinitely (manual advance)." .

## trn:tempo (from actions.ttl) — BPM override; absent means use the patch default.

trn:transition a owl:ObjectProperty ;
    rdfs:domain trn:Cue ;
    rdfs:range trn:Transition ;
    rdfs:label "transition" ;
    rdfs:comment "How to advance to the next cue. Defaults to trn:HardCut if absent." .

trn:onLoad a owl:ObjectProperty ;
    rdfs:domain trn:Cue ;
    rdfs:label "on load" ;
    rdfs:comment "rdf:List of trn:ParameterChange items applied immediately when the patch is loaded." .

trn:scheduled a owl:ObjectProperty ;
    rdfs:domain trn:Cue ;
    rdfs:label "scheduled" ;
    rdfs:comment "rdf:List of trn:ParameterChange items applied at specific beat offsets during the cue." .

## ── Transition properties ────────────────────────────────────────────────────

trn:fadeBeats a owl:DatatypeProperty ;
    rdfs:domain trn:Crossfade ;
    rdfs:range xsd:decimal ;
    rdfs:label "fade beats" ;
    rdfs:comment "Duration of the crossfade in beats at the current tempo." .

## ── ParameterChange properties ───────────────────────────────────────────────

## trn:atBeat (from actions.ttl) — beat offset from cue start; 0 = at load time.
## trn:parameterId (from actions.ttl) — VST3 parameter index on the target node.
## trn:normalizedValue (from actions.ttl) — target value in [0, 1].

trn:targetNode a owl:DatatypeProperty ;
    rdfs:domain trn:ParameterChange ;
    rdfs:range xsd:string ;
    rdfs:label "target node" ;
    rdfs:comment "Node identifier within the patch (matches the local name in the project Turtle)." .
