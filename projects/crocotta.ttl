@prefix : <http://purl.org/stuff/transmissions/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:main a :Transmission ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Transmission" ;
    :tempoMap ( [ :atBeat 0 ; :bpm 88 ] ) ;
    :loopStart 0 ;
    :loopEnd 256 ;
    :loopEnabled false ;
    :systemInputConnections ( "No connection" "No connection" ) ;
    :systemOutputConnections ( "UMC404HD 192k:playback_AUX0" "UMC404HD 192k:playback_AUX1" ) ;
    :audioSettings [ :renderAheadMs 500 ; :requestedBufferSize 0 ; :processingThreads 4 ] ;
    :pipe ( :conductor :polymeter :ground :melgen :mnemosyne :gremlin_driver :gremlin :campione :syrinx :basilico :floozy :rift :t_mix :lightverb :guardian :audio_out :drumgen ) ;
    :connections ( [ :from :conductor ; :to :ground ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :gremlin_driver ; :to :gremlin ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :polymeter ; :to :floozy ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :ground ; :to :basilico ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :ground ; :to :melgen ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :melgen ; :to :mnemosyne ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :mnemosyne ; :to :syrinx ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :syrinx ; :to :t_mix ; :kind "audio" ; :fromPort 0 ; :toPort 2 ] [ :from :syrinx ; :to :t_mix ; :kind "audio" ; :fromPort 1 ; :toPort 3 ] [ :from :basilico ; :to :t_mix ; :kind "audio" ; :fromPort 0 ; :toPort 4 ] [ :from :floozy ; :to :t_mix ; :kind "audio" ; :fromPort 0 ; :toPort 5 ] [ :from :gremlin ; :to :rift ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :gremlin ; :to :rift ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :rift ; :to :t_mix ; :kind "audio" ; :fromPort 0 ; :toPort 6 ] [ :from :rift ; :to :t_mix ; :kind "audio" ; :fromPort 1 ; :toPort 7 ] [ :from :t_mix ; :to :lightverb ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :t_mix ; :to :lightverb ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :lightverb ; :to :guardian ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :lightverb ; :to :guardian ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :guardian ; :to :audio_out ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :guardian ; :to :audio_out ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :conductor ; :to :drumgen ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :drumgen ; :to :campione ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :campione ; :to :t_mix ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :campione ; :to :t_mix ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] ) .

