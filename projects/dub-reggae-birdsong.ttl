@prefix : <http://purl.org/stuff/transmissions/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<dub-reggae-birdsong> a :Transmission ;
    :tempoMap ( [ :atBeat 0 ; :bpm 75 ] ) ;
    :systemOutputConnections ( "UMC404HD 192k-93:playback_AUX0" "UMC404HD 192k-93:playback_AUX1" ) ;
    :pipe ( <conductor> <mixgen> <drumgen> <drumkit> <ground> <basilico> <harmonic_atlas> <canticle> <melgen> <syrinx> <counterpointer> <t_mix> <loopdelay> <lightverb> <guardian> <audio_out> ) ;
    :connections ( [ :from <conductor> ; :to <drumgen> ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from <conductor> ; :to <ground> ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from <conductor> ; :to <harmonic_atlas> ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from <conductor> ; :to <melgen> ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from <mixgen> ; :to <t_mix> ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from <drumgen> ; :to <drumkit> ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from <ground> ; :to <basilico> ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from <harmonic_atlas> ; :to <canticle> ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from <melgen> ; :to <syrinx> ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from <melgen> ; :to <counterpointer> ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from <drumkit> ; :to <t_mix> ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from <drumkit> ; :to <t_mix> ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from <basilico> ; :to <t_mix> ; :kind "audio" ; :fromPort 0 ; :toPort 2 ] [ :from <canticle> ; :to <t_mix> ; :kind "audio" ; :fromPort 0 ; :toPort 3 ] [ :from <canticle> ; :to <t_mix> ; :kind "audio" ; :fromPort 1 ; :toPort 4 ] [ :from <syrinx> ; :to <t_mix> ; :kind "audio" ; :fromPort 0 ; :toPort 5 ] [ :from <syrinx> ; :to <t_mix> ; :kind "audio" ; :fromPort 1 ; :toPort 6 ] [ :from <t_mix> ; :to <loopdelay> ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from <t_mix> ; :to <loopdelay> ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from <loopdelay> ; :to <lightverb> ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from <loopdelay> ; :to <lightverb> ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from <lightverb> ; :to <guardian> ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from <lightverb> ; :to <guardian> ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from <guardian> ; :to <audio_out> ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from <guardian> ; :to <audio_out> ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from <counterpointer> ; :to <canticle> ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] ) .

<conductor> a :VST3Plugin ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Conductor" ;
    :midiOutputs 1 ;
    :editorX 100 ;
    :editorY 50 ;
    :settings [ :pluginPath "/home/danny/.vst3/conductor.vst3" ] .

