@prefix : <http://purl.org/stuff/transmissions/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:main a :Transmission ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Transmission" ;
    :tempoMap ( [ :atBeat 0 ; :bpm 120 ] ) ;
    :loopStart 0 ;
    :loopEnd 16 ;
    :loopEnabled false ;
    :systemInputConnections ( "UMC404HD 192k-90:capture_AUX0" "UMC404HD 192k-90:capture_AUX1" ) ;
    :systemOutputConnections ( "UMC404HD 192k:playback_FL" "UMC404HD 192k:playback_FR" ) ;
    :audioSettings [ :renderAheadMs 200 ; :requestedBufferSize 0 ; :processingThreads 0 ] ;
    :pipe ( :system-input :system-output :plugin-1 :plugin-2 ) ;
    :connections ( [ :from :plugin-1 ; :to :plugin-2 ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :plugin-2 ; :to :system-output ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :plugin-2 ; :to :system-output ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] ) .

:system-input a :AudioInput ;
    <http://www.w3.org/2000/01/rdf-schema#label> "System Input" ;
    :audioOutputs 2 ;
    :midiOutputs 1 ;
    :editorX 20 ;
    :editorY 70 .

:system-output a :AudioOutput ;
    <http://www.w3.org/2000/01/rdf-schema#label> "System Output" ;
    :audioInputs 2 ;
    :midiInputs 1 ;
    :editorX 580 ;
    :editorY 150 .

:plugin-1 a :VST3Plugin ;
    <http://www.w3.org/2000/01/rdf-schema#label> "BassGen" ;
    :audioOutputs 2 ;
    :midiInputs 1 ;
    :midiOutputs 1 ;
    :editorX 56 ;
    :editorY 198 ;
    :settings [ :pluginPath "/home/danny/.gemini/tmp/downspout/dist/bassgen.vst3" ] .

:plugin-2 a :VST3Plugin ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Basilico" ;
    :audioOutputs 2 ;
    :midiInputs 1 ;
    :editorX 330 ;
    :editorY 170 ;
    :settings [ :pluginPath "/home/danny/.gemini/tmp/downspout/dist/basilico.vst3" ] .
