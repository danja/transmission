@prefix : <http://purl.org/stuff/transmissions/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:main a :Transmission ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Transmission" ;
    :tempoMap ( [ :atBeat 0 ; :bpm 128 ] ) ;
    :loopStart 0 ;
    :loopEnd 32 ;
    :loopEnabled true ;
    :systemInputConnections ( "No connection" "No connection" ) ;
    :systemOutputConnections ( "system:playback_1" "system:playback_2" ) ;
    :audioSettings [ :renderAheadMs 200 ; :requestedBufferSize 0 ; :processingThreads 0 ] ;
    :pipe ( :system-input :conductor :drumgen :bassgen :melgen :harmonic-atlas :drumkit :basilico :syrinx :floozy :t-mix :rift :orbit :guardian :system-output ) ;
    :connections ( [ :from :conductor ; :to :melgen ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :conductor ; :to :harmonic-atlas ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :drumgen ; :to :drumkit ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :bassgen ; :to :basilico ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :melgen ; :to :syrinx ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :harmonic-atlas ; :to :floozy ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :drumkit ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :drumkit ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :basilico ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 2 ] [ :from :basilico ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 3 ] [ :from :syrinx ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 4 ] [ :from :syrinx ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 5 ] [ :from :floozy ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 6 ] [ :from :floozy ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 7 ] [ :from :t-mix ; :to :rift ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :t-mix ; :to :rift ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :rift ; :to :orbit ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :rift ; :to :orbit ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :orbit ; :to :guardian ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :orbit ; :to :guardian ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] ) .

:system-input a :AudioInput ;
    <http://www.w3.org/2000/01/rdf-schema#label> "System Input" ;
    :audioOutputs 2 ;
    :midiOutputs 1 ;
    :editorX 40 ;
    :editorY 520 .

