@prefix : <http://purl.org/stuff/transmissions/> .

:hardcore-melodic-techno a :Transmission ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Hardcore Melodic Techno" ;
    :tempoMap ( [ :atBeat 0 ; :bpm 158 ] ) ;
    :loopStart 0 ;
    :loopEnd 128 ;
    :loopEnabled true ;
    :systemInputConnections ( "No connection" "No connection" ) ;
    :systemOutputConnections ( "UMC404HD 192k:playback_FL" "UMC404HD 192k:playback_FR" ) ;
    :pipe (
        :system-input
        :polymeter :drumkit
        :bassgen :basilico
        :conductor :harmonic-atlas :canticle :orbit
        :arpgen :arp-canticle
        :t-mix :guardian :system-output
    ) ;
    :connections (
        [ :from :polymeter ; :to :drumkit ; :kind "midi" ; :fromPort 0 ; :toPort 0 ]
        [ :from :bassgen ; :to :basilico ; :kind "midi" ; :fromPort 0 ; :toPort 0 ]
        [ :from :conductor ; :to :harmonic-atlas ; :kind "midi" ; :fromPort 0 ; :toPort 0 ]
        [ :from :harmonic-atlas ; :to :canticle ; :kind "midi" ; :fromPort 0 ; :toPort 0 ]
        [ :from :harmonic-atlas ; :to :arpgen ; :kind "midi" ; :fromPort 0 ; :toPort 0 ]
        [ :from :arpgen ; :to :arp-canticle ; :kind "midi" ; :fromPort 0 ; :toPort 0 ]
        [ :from :canticle ; :to :orbit ; :kind "audio" ; :fromPort 0 ; :toPort 0 ]
        [ :from :canticle ; :to :orbit ; :kind "audio" ; :fromPort 1 ; :toPort 1 ]
        [ :from :drumkit ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 0 ]
        [ :from :drumkit ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 1 ]
        [ :from :basilico ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 2 ]
        [ :from :basilico ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 3 ]
        [ :from :arp-canticle ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 4 ]
        [ :from :arp-canticle ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 5 ]
        [ :from :orbit ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 6 ]
        [ :from :orbit ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 7 ]
        [ :from :t-mix ; :to :guardian ; :kind "audio" ; :fromPort 0 ; :toPort 0 ]
        [ :from :t-mix ; :to :guardian ; :kind "audio" ; :fromPort 1 ; :toPort 1 ]
        [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 0 ; :toPort 0 ]
        [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 1 ; :toPort 1 ]
    ) .

