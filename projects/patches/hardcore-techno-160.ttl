@prefix : <http://purl.org/stuff/transmissions/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:main a :Transmission ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Transmission" ;
    :tempoMap ( [ :atBeat 0 ; :bpm 160 ] ) ;
    :loopStart 0 ;
    :loopEnd 128 ;
    :loopEnabled true ;
    :systemInputConnections ( "No connection" "No connection" ) ;
    :systemOutputConnections ( "UMC404HD 192k:playback_AUX0" "UMC404HD 192k:playback_AUX1" ) ;
    :pipe ( :system-input :drumgen :drumkit :xoxolo :bassgen :basilico :arpgen :canticle :sidecar :gremlin-driver :gremlin :oracle :ambo :rift :tmix :guardian :system-output ) ;
    :connections ( [ :from :drumgen ; :to :drumkit ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :xoxolo ; :to :drumkit ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :drumgen ; :to :bassgen ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :bassgen ; :to :basilico ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :bassgen ; :to :arpgen ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :arpgen ; :to :canticle ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :sidecar ; :to :canticle ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :system-input ; :to :canticle ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :gremlin-driver ; :to :gremlin ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :arpgen ; :to :gremlin ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :drumkit ; :to :tmix ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :drumkit ; :to :tmix ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :basilico ; :to :ambo ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :basilico ; :to :ambo ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :ambo ; :to :oracle ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :ambo ; :to :oracle ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :oracle ; :to :rift ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :oracle ; :to :rift ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :rift ; :to :tmix ; :kind "audio" ; :fromPort 0 ; :toPort 2 ] [ :from :rift ; :to :tmix ; :kind "audio" ; :fromPort 1 ; :toPort 3 ] [ :from :canticle ; :to :tmix ; :kind "audio" ; :fromPort 0 ; :toPort 4 ] [ :from :canticle ; :to :tmix ; :kind "audio" ; :fromPort 1 ; :toPort 5 ] [ :from :gremlin ; :to :tmix ; :kind "audio" ; :fromPort 0 ; :toPort 6 ] [ :from :gremlin ; :to :tmix ; :kind "audio" ; :fromPort 1 ; :toPort 7 ] [ :from :tmix ; :to :guardian ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :tmix ; :to :guardian ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] ) .

