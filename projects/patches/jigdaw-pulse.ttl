@prefix : <http://purl.org/stuff/transmissions/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:main a :Transmission ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Transmission" ;
    :tempoMap ( [ :atBeat 0 ; :bpm 128 ] ) ;
    :loopStart 0 ;
    :loopEnd 16 ;
    :loopEnabled true ;
    :systemInputConnections ( "No connection" "No connection" ) ;
    :systemOutputConnections ( "Built-in Audio Analog Stereo:playback_FL" "Built-in Audio Analog Stereo:playback_FR" ) ;
    :audioSettings [ :renderAheadMs 200 ; :requestedBufferSize 0 ; :processingThreads 0 ] ;
    :pipe ( :bassgen :pulse :system-output :jigdaw-1 ) ;
    :connections ( [ :from :bassgen ; :to :pulse ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :pulse ; :to :jigdaw-1 ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :jigdaw-1 ; :to :system-output ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :pulse ; :to :system-output ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] ) .

:bassgen a :JigdawPlugin ;
    <http://www.w3.org/2000/01/rdf-schema#label> "BassGen" ;
    :midiInputs 1 ;
    :midiOutputs 1 ;
    :editorX 40 ;
    :editorY 120 ;
    :settings [ :pluginIri "file:///home/danny/github/jigdaw/plugins/bassgen/" ] .

:pulse a :JigdawPlugin ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Pulse" ;
    :audioOutputs 2 ;
    :midiInputs 1 ;
    :editorX 320 ;
    :editorY 120 ;
    :settings [ :pluginIri "file:///home/danny/github/jigdaw/plugins/pulse/" ] ;
    :parameters ( [ :parameterId 0 ; :normalizedValue 0 ] [ :parameterId 1 ; :normalizedValue 0.00900901 ] [ :parameterId 2 ; :normalizedValue 0.0497624 ] [ :parameterId 3 ; :normalizedValue 0.329609 ] [ :parameterId 4 ; :normalizedValue 0.691 ] ) .

:system-output a :AudioOutput ;
    <http://www.w3.org/2000/01/rdf-schema#label> "System Output" ;
    :audioInputs 2 ;
    :midiInputs 1 ;
    :editorX 598 ;
    :editorY 205.933 .

:jigdaw-1 a :JigdawPlugin ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Ferrite" ;
    :audioInputs 2 ;
    :audioOutputs 2 ;
    :editorX 344.786 ;
    :editorY 288.798 ;
    :settings [ :pluginIri "https://strandz.it/jigdaw/plugins/ferrite/" ] ;
    :parameters ( [ :parameterId 0 ; :normalizedValue 0.25 ] [ :parameterId 1 ; :normalizedValue 0.5 ] [ :parameterId 2 ; :normalizedValue 1 ] [ :parameterId 3 ; :normalizedValue 0.564 ] ) .
