@prefix : <http://purl.org/stuff/transmissions/> .

:kraurock-jazz a :Transmission ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Kraurock-Flavoured Jazz" ;
    :tempoMap ( [ :atBeat 0 ; :bpm 126 ] ) ;
    :loopStart 0 ;
    :loopEnd 128 ;
    :loopEnabled true ;
    :systemInputConnections ( "No connection" "No connection" ) ;
    :systemOutputConnections ( "system:playback_1" "system:playback_2" ) ;
    :pipe (
        :system-input
        :polymeter :drumkit
        :bassgen :basilico
        :harmonic-atlas :keys-canticle
        :counterpointer :reed-canticle
        :t-mix :guardian :system-output
    ) ;
    :connections (
        [ :from :polymeter ; :to :drumkit ; :kind "midi" ; :fromPort 0 ; :toPort 0 ]
        [ :from :bassgen ; :to :basilico ; :kind "midi" ; :fromPort 0 ; :toPort 0 ]
        [ :from :harmonic-atlas ; :to :keys-canticle ; :kind "midi" ; :fromPort 0 ; :toPort 0 ]
        [ :from :harmonic-atlas ; :to :counterpointer ; :kind "midi" ; :fromPort 0 ; :toPort 0 ]
        [ :from :counterpointer ; :to :reed-canticle ; :kind "midi" ; :fromPort 0 ; :toPort 0 ]
        [ :from :drumkit ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 0 ]
        [ :from :drumkit ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 1 ]
        [ :from :basilico ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 2 ]
        [ :from :basilico ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 3 ]
        [ :from :keys-canticle ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 4 ]
        [ :from :keys-canticle ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 5 ]
        [ :from :reed-canticle ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 6 ]
        [ :from :reed-canticle ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 7 ]
        [ :from :t-mix ; :to :guardian ; :kind "audio" ; :fromPort 0 ; :toPort 0 ]
        [ :from :t-mix ; :to :guardian ; :kind "audio" ; :fromPort 1 ; :toPort 1 ]
        [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 0 ; :toPort 0 ]
        [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 1 ; :toPort 1 ]
    ) .

