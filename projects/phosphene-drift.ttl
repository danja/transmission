@prefix : <http://purl.org/stuff/transmissions/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:main a :Transmission ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Transmission" ;
    :tempoMap ( [ :atBeat 0 ; :bpm 72 ] ) ;
    :loopStart 0 ;
    :loopEnd 256 ;
    :loopEnabled true ;
    :systemInputConnections ( "No connection" "No connection" ) ;
    :systemOutputConnections ( "system:playback_1" "system:playback_2" ) ;
    :audioSettings [ :renderAheadMs 200 ; :requestedBufferSize 0 ; :processingThreads 0 ] ;
    :pipe ( :conductor :harmonic-atlas :melgen :drumgen :ground :syrinx :canticle :drumkit :basilico :t-mix :loopdelay :lightverb :guardian :system-output :plugin-1 :plugin-2 :plugin-3 ) ;
    :connections ( [ :from :conductor ; :to :harmonic-atlas ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :conductor ; :to :drumgen ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :conductor ; :to :ground ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :harmonic-atlas ; :to :melgen ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :harmonic-atlas ; :to :canticle ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :melgen ; :to :syrinx ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :drumgen ; :to :drumkit ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :ground ; :to :basilico ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :syrinx ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :syrinx ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :canticle ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 2 ] [ :from :canticle ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 3 ] [ :from :basilico ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 6 ] [ :from :basilico ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 7 ] [ :from :t-mix ; :to :loopdelay ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :t-mix ; :to :loopdelay ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :loopdelay ; :to :lightverb ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :loopdelay ; :to :lightverb ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :lightverb ; :to :guardian ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :lightverb ; :to :guardian ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :drumkit ; :to :plugin-1 ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :drumkit ; :to :plugin-1 ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :plugin-1 ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 4 ] [ :from :plugin-1 ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 5 ] [ :from :ground ; :to :plugin-2 ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :plugin-2 ; :to :plugin-3 ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :plugin-3 ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 4 ] [ :from :plugin-3 ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 5 ] ) .

