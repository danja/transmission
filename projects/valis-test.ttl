@prefix : <http://purl.org/stuff/transmissions/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:main a :Transmission ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Transmission" ;
    :tempoMap ( [ :atBeat 0 ; :bpm 120 ] ) ;
    :loopStart 0 ;
    :loopEnd 16 ;
    :loopEnabled false ;
    :systemInputConnections ( "system:capture_1" "system:capture_2" ) ;
    :systemOutputConnections ( "system:playback_1" "system:playback_2" ) ;
    :audioSettings [ :renderAheadMs 200 ; :requestedBufferSize 0 ; :processingThreads 0 ] ;
    :pipe ( :system-input :system-output :plugin-1 :plugin-2 ) ;
    :connections ( [ :from :plugin-2 ; :to :plugin-1 ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :plugin-1 ; :to :system-output ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :plugin-1 ; :to :system-output ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] ) .

:system-input a :AudioInput ;
    <http://www.w3.org/2000/01/rdf-schema#label> "System Input" ;
    :audioOutputs 2 ;
    :midiOutputs 1 ;
    :editorX 60 ;
    :editorY 150 .

:system-output a :AudioOutput ;
    <http://www.w3.org/2000/01/rdf-schema#label> "System Output" ;
    :audioInputs 2 ;
    :midiInputs 1 ;
    :editorX 580 ;
    :editorY 150 .

