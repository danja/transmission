#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "$ROOT_DIR/bin/transmission_graph_ui" ]]; then
  APP="$ROOT_DIR/bin/transmission_graph_ui"
else
  APP="$ROOT_DIR/native/build-ui-jack-vst3/transmission_graph_ui"
fi

if [[ ! -x "$APP" ]]; then
  echo "Transmission UI is not built. Run ./build.sh first." >&2
  exit 1
fi

export GDK_BACKEND=x11
export TRANSMISSION_ROOT="$ROOT_DIR"
exec "$APP" "$@"
