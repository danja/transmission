#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP="$ROOT_DIR/native/build-ui-jack-vst3/transmission_graph_ui"

if [[ ! -x "$APP" ]]; then
  echo "Transmission UI is not built. Run ./build.sh first." >&2
  exit 1
fi

export GDK_BACKEND=x11
exec "$APP" "$@"
